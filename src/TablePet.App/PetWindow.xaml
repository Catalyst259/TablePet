<Window x:Class="TablePet.App.PetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TablePet" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize" ShowInTaskbar="False"
        ShowActivated="False" Focusable="False" Topmost="True"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Grid>
      <Image x:Name="PetImage" Stretch="Fill" Focusable="False"
             RenderOptions.BitmapScalingMode="HighQuality">
        <Image.RenderTransform><TranslateTransform x:Name="PetShift"/></Image.RenderTransform>
      </Image>
      <Image x:Name="WorkPropsImage" Stretch="Fill" Focusable="False" IsHitTestVisible="False"
             Visibility="Collapsed" RenderOptions.BitmapScalingMode="HighQuality"/>
    </Grid>
</Window>
