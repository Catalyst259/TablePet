<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon Condition="Exists('../../assets/strawberry-cat/tray.ico')">../../assets/strawberry-cat/tray.ico</ApplicationIcon>
    <AssemblyName>TablePet.Skeletal</AssemblyName>
    <RootNamespace>TablePet.App</RootNamespace>
    <Version>0.5.0-skeletal</Version>
    <Product>草莓猫桌宠 · 骨骼版</Product>
    <!-- WPF owns PerMonitorV2 via app.manifest; WinForms is used only for NotifyIcon. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <Description>本地运行的草莓猫 Windows 桌面宠物</Description>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="TablePet.App.Tests" />
    <ProjectReference Include="../TablePet.Core/TablePet.Core.csproj" />
    <Content Include="../../assets/strawberry-cat/skeletal/**" Link="Assets/strawberry-cat/skeletal/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <Content Include="../../assets/strawberry-cat/*.json;../../assets/strawberry-cat/*.png;../../assets/strawberry-cat/*.ico" Link="Assets/strawberry-cat/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>
</Project>
