<Window x:Class="TablePet.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="草莓猫 · 设置" Width="640" Height="760" MinWidth="580" MinHeight="600"
        Background="#FFF9F7" FontFamily="Microsoft YaHei UI" Foreground="#352B35"
        WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <Style TargetType="TextBox"><Setter Property="Padding" Value="10,7"/><Setter Property="Margin" Value="0,3"/><Setter Property="BorderBrush" Value="#E2D7DB"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
    <Style TargetType="CheckBox"><Setter Property="Margin" Value="0,7"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
    <Style TargetType="Button"><Setter Property="Padding" Value="15,8"/><Setter Property="Margin" Value="6,0,0,0"/></Style>
  </Window.Resources>
  <DockPanel Margin="28">
    <StackPanel DockPanel.Dock="Top">
      <TextBlock Text="草莓猫" FontSize="30" FontWeight="SemiBold"/>
      <TextBlock Text="一点陪伴，刚刚好。" Foreground="#8D7785" Margin="0,5,0,18"/>
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
      <TextBlock x:Name="Feedback" Text="修改后立即生效，并自动保存。" Foreground="#8D7785" TextWrapping="Wrap" Margin="0,0,0,12"/>
      <DockPanel>
        <Button Content="恢复默认" HorizontalAlignment="Left" Click="Reset_Click" Margin="0"/>
        <Button Content="完成" HorizontalAlignment="Right" Click="Done_Click"/>
      </DockPanel>
    </StackPanel>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="0,0,12,0">
        <Border Background="#F8ECEF" CornerRadius="16" Padding="16" Margin="0,0,0,20">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="96"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Image x:Name="Preview" Height="90" Stretch="Uniform"/>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0">
              <TextBlock Text="你的桌面小伙伴" FontWeight="SemiBold" FontSize="16"/>
              <TextBlock Text="拖动身体移动位置 · 右键打开菜单" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="#8D7785"/>
              <TextBlock Text="隐藏或穿透后，可从系统托盘找回。" TextWrapping="Wrap" Margin="0,3,0,0" Foreground="#8D7785"/>
            </StackPanel>
          </Grid>
        </Border>
        <TextBlock Text="互动与休息" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="210"/></Grid.ColumnDefinitions>
          <TextBlock Text="互动方式" VerticalAlignment="Center"/>
          <TextBlock Grid.Column="1" Text="悬停唤醒 · 点击起身" Padding="10,7" Foreground="#8D7785" VerticalAlignment="Center"/>
        </Grid>
        <CheckBox x:Name="AutoSleep" Content="一段时间没有互动后自动入睡" Click="Option_Changed"/>
        <Grid x:Name="TimingGrid" Margin="0,7,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="100"/><ColumnDefinition Width="72"/></Grid.ColumnDefinitions>
          <Grid.RowDefinitions><RowDefinition Height="46"/><RowDefinition Height="46"/><RowDefinition Height="46"/><RowDefinition Height="46"/><RowDefinition Height="46"/><RowDefinition Height="46"/></Grid.RowDefinitions>
          <TextBlock Text="多久后入睡" VerticalAlignment="Center"/><TextBox x:Name="SleepSeconds" Grid.Column="1" LostFocus="Number_Changed"/><TextBlock Text="秒" Grid.Column="2" Margin="12,0" VerticalAlignment="Center"/>
          <TextBlock Text="眨眼间隔 · 最短" Grid.Row="1" VerticalAlignment="Center"/><TextBox x:Name="BlinkMin" Grid.Row="1" Grid.Column="1" LostFocus="Number_Changed"/><TextBlock Text="秒" Grid.Row="1" Grid.Column="2" Margin="12,0" VerticalAlignment="Center"/>
          <TextBlock Text="眨眼间隔 · 最长" Grid.Row="2" VerticalAlignment="Center"/><TextBox x:Name="BlinkMax" Grid.Row="2" Grid.Column="1" LostFocus="Number_Changed"/><TextBlock Text="秒" Grid.Row="2" Grid.Column="2" Margin="12,0" VerticalAlignment="Center"/>
          <TextBlock Text="起身后停留" Grid.Row="3" VerticalAlignment="Center"/><TextBox x:Name="HoldSeconds" Grid.Row="3" Grid.Column="1" LostFocus="Number_Changed"/><TextBlock Text="秒" Grid.Row="3" Grid.Column="2" Margin="12,0" VerticalAlignment="Center"/>
          <TextBlock Text="两次动作之间的休息" Grid.Row="4" VerticalAlignment="Center"/><TextBox x:Name="CooldownSeconds" Grid.Row="4" Grid.Column="1" LostFocus="Number_Changed"/><TextBlock Text="秒" Grid.Row="4" Grid.Column="2" Margin="12,0" VerticalAlignment="Center"/>
          <TextBlock Text="悬停多久后唤醒" Grid.Row="5" VerticalAlignment="Center"/><TextBox x:Name="HoverMs" Grid.Row="5" Grid.Column="1" LostFocus="Number_Changed"/><TextBlock Text="毫秒" Grid.Row="5" Grid.Column="2" Margin="12,0" VerticalAlignment="Center"/>
        </Grid>
        <TextBlock Text="桌面显示" FontSize="18" FontWeight="SemiBold" Margin="0,24,0,12"/>
        <DockPanel><TextBlock Text="猫咪大小"/><TextBlock x:Name="SizeLabel" HorizontalAlignment="Right"/></DockPanel>
        <Slider x:Name="PetSize" Minimum="120" Maximum="480" TickFrequency="10" IsSnapToTickEnabled="True" ValueChanged="Size_Changed" Margin="0,10,0,10"/>
        <CheckBox x:Name="AlwaysTop" Content="始终显示在其他窗口上方" Click="Option_Changed"/>
        <CheckBox x:Name="PassThrough" Content="鼠标穿透猫咪（通过托盘恢复）" Click="Option_Changed"/>
        <CheckBox x:Name="Startup" Content="登录 Windows 时启动" Click="Option_Changed"/>
        <TextBlock Text="仅与猫咪的互动会推迟入睡；在其他软件打字不影响它休息。" TextWrapping="Wrap" Foreground="#8D7785" Margin="0,15,0,0"/>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
