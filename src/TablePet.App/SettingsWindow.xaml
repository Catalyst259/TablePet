<Window x:Class="TablePet.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="草莓猫 · 设置" Width="640" Height="760" MinWidth="580" MinHeight="600"
        Background="#FFF9F7" FontFamily="Microsoft YaHei UI" Foreground="#352B35"
        WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <Style TargetType="TextBox"><Setter Property="Padding" Value="10,7"/><Setter Property="Margin" Value="0,3"/><Setter Property="BorderBrush" Value="#E2D7DB"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
    <Style TargetType="CheckBox"><Setter Property="Margin" Value="0,7"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
    <Style TargetType="Button"><Setter Property="Padding" Value="15,8"/><Setter Property="Margin" Value="6,0,0,0"/></Style>
  </Window.Resources>
  <DockPanel Margin="28">
    <StackPanel DockPanel.Dock="Top">
      <TextBlock Text="草莓猫" FontSize="30" FontWeight="SemiBold"/>
      <TextBlock Text="一点陪伴，刚刚好。" Foreground="#8D7785" Margin="0,5,0,18"/>
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
      <TextBlock x:Name="Feedback" Text="修改后立即生效，并自动保存。" Foreground="#8D7785" TextWrapping="Wrap" Margin="0,0,0,12"/>
      <DockPanel>
        <Button Content="恢复默认" HorizontalAlignment="Left" Click="Reset_Click" Margin="0"/>
        <Button Content="完成" HorizontalAlignment="Right" Click="Done_Click"/>
      </DockPanel>
    </StackPanel>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="0,0,12,0">
        <Border Background="#F8ECEF" CornerRadius="16" Padding="16" Margin="0,0,0,20">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="96"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Image x:Name="Preview" Height="90" Stretch="Uniform"/>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0">
              <TextBlock Text="你的桌面小伙伴" FontWeight="SemiBold" FontSize="16"/>
              <TextBlock Text="拖动身体移动位置 · 右键打开菜单" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="#8D7785"/>
              <TextBlock Text="隐藏或穿透后，可从系统托盘找回。" TextWrapping="Wrap" Margin="0,3,0,0" Foreground="#8D7785"/>
            </StackPanel>
          </Grid>
        </Border>
        <TextBlock Text="陪伴模式" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
          <RadioButton x:Name="DailyMode" GroupName="CompanionMode" Content="日常陪伴" Margin="0,0,28,0" Checked="Mode_Checked" Click="Mode_Click"/>
          <RadioButton x:Name="WorkMode" GroupName="CompanionMode" Content="工作模式" Checked="Mode_Checked" Click="Mode_Click"/>
        </StackPanel>
        <TextBlock Text="工作时一起专注，到点提醒并睡觉休息，醒后开始下一轮。休息中点击会短暂回应，再继续睡。" TextWrapping="Wrap" Foreground="#8D7785" Margin="0,0,0,8"/>
        <Grid Margin="0,0,0,8">
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="100"/><ColumnDefinition Width="72"/></Grid.ColumnDefinitions>
          <Grid.RowDefinitions><RowDefinition Height="46"/><RowDefinition Height="46"/></Grid.RowDefinitions>
          <TextBlock Text="每轮工作" VerticalAlignment="Center"/><TextBox x:Name="WorkMinutes" Grid.Column="1" LostFocus="Number_Changed"/><TextBlock Text="分钟" Grid.Column="2" Margin="12,0" VerticalAlignment="Center"/>
          <TextBlock Text="每轮休息" Grid.Row="1" VerticalAlignment="Center"/><TextBox x:Name="BreakMinutes" Grid.Row="1" Grid.Column="1" LostFocus="Number_Changed"/><TextBlock Text="分钟" Grid.Row="1" Grid.Column="2" Margin="12,0" VerticalAlignment="Center"/>
        </Grid>
        <TextBlock Text="时长仅用于工作模式，可输入小数；切换模式立即生效。" TextWrapping="Wrap" Foreground="#8D7785" Margin="0,0,0,20"/>
        <TextBlock Text="日常陪伴设置" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <TextBlock Text="以下互动与自动休息规则仅在日常模式生效。" TextWrapping="Wrap" Foreground="#8D7785" Margin="0,0,0,10"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="210"/></Grid.ColumnDefinitions>
          <TextBlock Text="互动方式" VerticalAlignment="Center"/>
          <TextBlock Grid.Column="1" Text="悬停唤醒 · 点击互动" Padding="10,7" Foreground="#8D7785" VerticalAlignment="Center"/>
        </Grid>
        <CheckBox x:Name="AutoSleep" Content="一段时间没有互动后自动入睡" Click="Option_Changed"/>
        <Grid x:Name="TimingGrid" Margin="0,7,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="100"/><ColumnDefinition Width="72"/></Grid.ColumnDefinitions>
          <Grid.RowDefinitions><RowDefinition Height="46"/><RowDefinition Height="46"/><RowDefinition Height="46"/><RowDefinition Height="46"/><RowDefinition Height="46"/><RowDefinition Height="46"/></Grid.RowDefinitions>
          <TextBlock Text="多久后入睡" VerticalAlignment="Center"/><TextBox x:Name="SleepSeconds" Grid.Column="1" LostFocus="Number_Changed"/><TextBlock Text="秒" Grid.Column="2" Margin="12,0" VerticalAlignment="Center"/>
          <TextBlock Text="待机动作间隔 · 最短" Grid.Row="1" VerticalAlignment="Center"/><TextBox x:Name="BlinkMin" Grid.Row="1" Grid.Column="1" LostFocus="Number_Changed"/><TextBlock Text="秒" Grid.Row="1" Grid.Column="2" Margin="12,0" VerticalAlignment="Center"/>
          <TextBlock Text="待机动作间隔 · 最长" Grid.Row="2" VerticalAlignment="Center"/><TextBox x:Name="BlinkMax" Grid.Row="2" Grid.Column="1" LostFocus="Number_Changed"/><TextBlock Text="秒" Grid.Row="2" Grid.Column="2" Margin="12,0" VerticalAlignment="Center"/>
          <TextBlock Text="自动起身后停留" Grid.Row="3" VerticalAlignment="Center"/><TextBox x:Name="HoldSeconds" Grid.Row="3" Grid.Column="1" LostFocus="Number_Changed"/><TextBlock Text="秒" Grid.Row="3" Grid.Column="2" Margin="12,0" VerticalAlignment="Center"/>
          <TextBlock Text="两次点击回应之间的休息" Grid.Row="4" VerticalAlignment="Center"/><TextBox x:Name="CooldownSeconds" Grid.Row="4" Grid.Column="1" LostFocus="Number_Changed"/><TextBlock Text="秒" Grid.Row="4" Grid.Column="2" Margin="12,0" VerticalAlignment="Center"/>
          <TextBlock Text="悬停多久后唤醒" Grid.Row="5" VerticalAlignment="Center"/><TextBox x:Name="HoverMs" Grid.Row="5" Grid.Column="1" LostFocus="Number_Changed"/><TextBlock Text="毫秒" Grid.Row="5" Grid.Column="2" Margin="12,0" VerticalAlignment="Center"/>
        </Grid>
        <TextBlock Text="待机随机眨眼、打哈欠、起身或追萤火虫，机会比例为 2:1:1:1，可能连续重复。单击等概率回应单眼眨或喵叫；双击始终喵叫。" TextWrapping="Wrap" Foreground="#8D7785" Margin="0,9,0,0"/>
        <TextBlock Text="我们的日常" FontSize="18" FontWeight="SemiBold" Margin="0,24,0,12"/>
        <CheckBox x:Name="RecordCompanionship" Content="记录相伴成长" Click="Option_Changed"/>
        <TextBlock Text="关闭后暂停新记录，已经熟悉的关系与回忆会保留。" TextWrapping="Wrap" Foreground="#705D68"/>
        <CheckBox x:Name="CompanionText" Content="显示陪伴短句" Click="Option_Changed"/>
        <TextBlock Text="每次点击回应都会显示新短句；关闭后保留互动动作和基础工作、休息提示。" TextWrapping="Wrap" Foreground="#705D68"/>
        <Button x:Name="OpenCompanionButton" Content="看看我们的日常…" HorizontalAlignment="Left" Margin="0,12,0,0" Click="Companion_Click"/>
        <TextBlock Text="桌面显示" FontSize="18" FontWeight="SemiBold" Margin="0,24,0,12"/>
        <DockPanel><TextBlock Text="猫咪大小"/><TextBlock x:Name="SizeLabel" HorizontalAlignment="Right"/></DockPanel>
        <Slider x:Name="PetSize" Minimum="120" Maximum="480" TickFrequency="10" IsSnapToTickEnabled="True" ValueChanged="Size_Changed" Margin="0,10,0,10"/>
        <CheckBox x:Name="AlwaysTop" Content="始终显示在其他窗口上方" Click="Option_Changed"/>
        <CheckBox x:Name="PassThrough" Content="鼠标穿透猫咪（通过托盘恢复）" Click="Option_Changed"/>
        <CheckBox x:Name="Startup" Content="登录 Windows 时启动" Click="Option_Changed"/>
        <TextBlock Text="日常模式下，仅与猫咪的互动会推迟入睡；在其他软件打字不影响它休息。" TextWrapping="Wrap" Foreground="#8D7785" Margin="0,15,0,0"/>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
