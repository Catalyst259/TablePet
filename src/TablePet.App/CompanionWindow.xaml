<Window x:Class="TablePet.App.CompanionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="草莓猫 · 我们的日常" Width="480" Height="640" MinWidth="420" MinHeight="480"
        Background="#FFF9F7" Foreground="#352B35" FontFamily="Microsoft YaHei UI"
        WindowStartupLocation="CenterScreen" PreviewKeyDown="Window_KeyDown">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="12,7"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="Background" Value="#F8ECEF"/>
      <Setter Property="BorderBrush" Value="#D8C5CE"/>
    </Style>
    <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
  </Window.Resources>
  <ScrollViewer x:Name="ContentScroll" VerticalScrollBarVisibility="Auto" ScrollChanged="Content_Scrolled">
    <StackPanel Margin="24">
      <TextBlock Text="我们的日常" FontSize="26" FontWeight="SemiBold" Margin="0,0,0,18"/>
      <Border x:Name="StatusBanner" Background="#FFF0DA" CornerRadius="10" Padding="14" Margin="0,0,0,16" Visibility="Collapsed">
        <StackPanel>
          <TextBlock x:Name="StatusText" Foreground="#704A20"/>
          <WrapPanel Margin="0,10,0,0">
            <Button x:Name="RetryButton" Content="重试保存" Click="Retry_Click"/>
            <Button x:Name="FolderButton" Content="打开记录文件夹" Click="Folder_Click"/>
            <Button x:Name="RestartButton" Content="重新开始记录…" Click="Restart_Click" Margin="0,6,0,0" Visibility="Collapsed"/>
          </WrapPanel>
        </StackPanel>
      </Border>
      <Border Background="#F8ECEF" CornerRadius="16" Padding="16">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Image x:Name="Preview" Width="90" Height="90" Stretch="Uniform" AutomationProperties.Name="草莓猫"/>
          <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
            <TextBlock x:Name="StageName" FontSize="24" FontWeight="SemiBold"/>
            <TextBlock x:Name="StageDescription" Margin="0,5,0,6" Foreground="#705D68"/>
            <TextBlock x:Name="DayCount" FontWeight="SemiBold"/>
          </StackPanel>
        </Grid>
      </Border>
      <TextBlock x:Name="StageTrail" Text="初见  ·  熟悉  ·  亲近  ·  默契" Foreground="#705D68" Margin="0,16,0,8"/>
      <ProgressBar x:Name="StageProgress" Minimum="0" Maximum="100" Height="8" Foreground="#A56681"
                   Background="#EADDE2" BorderThickness="0" AutomationProperties.Name="下一关系阶段进度"/>
      <TextBlock x:Name="ProgressDescription" Foreground="#705D68" Margin="0,8,0,12"/>
      <Expander Header="成长说明" Margin="0,0,0,20">
        <StackPanel Margin="4,10,4,0">
          <TextBlock Text="与小猫互动、主动开始工作，或打开这个面板后，会记录一小段可见陪伴。每天累计 1 分钟开始获得熟悉度，20 分钟达到当日上限。日常和工作都可以成长，不需要连续使用，离开也不会失去关系。" Foreground="#705D68"/>
          <TextBlock x:Name="ScoreDetail" Margin="0,10,0,5"/>
          <TextBlock x:Name="NextRequirement"/>
        </StackPanel>
      </Expander>
      <TextBlock x:Name="DisabledNotice" Text="成长记录已暂停，原有回忆仍在这里。" Foreground="#705D68" Margin="0,0,0,16" Visibility="Collapsed"/>
      <TextBlock Text="我们的回忆" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,12"/>
      <TextBlock x:Name="EmptyNotice" Text="和小猫打个招呼，日常会慢慢记在这里。" Foreground="#705D68" Margin="0,0,0,18"/>
      <StackPanel x:Name="MemoryItems"/>
      <TextBlock x:Name="RecordingDate" Foreground="#705D68" FontSize="12" Margin="0,12,0,4"/>
      <TextBlock x:Name="MigrationNotice" Text="相伴记录从本次更新后开始，之前的日常不会被推算。" Foreground="#705D68" FontSize="12" Visibility="Collapsed"/>
      <Button Content="关闭" HorizontalAlignment="Right" Click="Close_Click" Margin="0,20,0,0"/>
    </StackPanel>
  </ScrollViewer>
</Window>
