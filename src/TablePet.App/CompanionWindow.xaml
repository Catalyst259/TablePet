<Window x:Class="TablePet.App.CompanionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TablePet · 我们的日常" Width="520" Height="720" MinWidth="420" MinHeight="480"
        Background="#FFF9F7" Foreground="#352B35" FontFamily="Microsoft YaHei UI" FontSize="14"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen" PreviewKeyDown="Window_KeyDown">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="16,9"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="Background" Value="#F8ECEF"/>
      <Setter Property="BorderBrush" Value="#D8C5CE"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Foreground" Value="#352B35"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="#F0DFE6"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#89516B"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="#E8D1DC"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style x:Key="StageStep" TargetType="Border">
      <Setter Property="CornerRadius" Value="7"/>
      <Setter Property="Padding" Value="0,7"/>
      <Setter Property="Margin" Value="2,0"/>
    </Style>
  </Window.Resources>
  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Margin="24,24,24,18">
      <TextBlock Text="我们的日常" FontSize="26" FontWeight="SemiBold"/>
    </StackPanel>
    <Border DockPanel.Dock="Bottom" BorderBrush="#EADDE2" BorderThickness="0,1,0,0" Padding="24,12" Background="#FFF9F7">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock x:Name="RecordingDate" Foreground="#705D68" FontSize="12" VerticalAlignment="Center" Margin="0,0,12,0"/>
        <Button Grid.Column="1" Content="关闭" MinWidth="80" Click="Close_Click" Margin="0"/>
      </Grid>
    </Border>
  <ScrollViewer x:Name="ContentScroll" VerticalScrollBarVisibility="Auto" ScrollChanged="Content_Scrolled">
    <StackPanel Margin="24,0,24,20">
      <Border x:Name="StatusBanner" Background="#FFF0DA" CornerRadius="10" Padding="14" Margin="0,0,0,16" Visibility="Collapsed">
        <StackPanel>
          <TextBlock x:Name="StatusText" Foreground="#704A20"/>
          <WrapPanel Margin="0,10,0,0">
            <Button x:Name="RetryButton" Content="重试保存" Click="Retry_Click"/>
            <Button x:Name="FolderButton" Content="打开记录文件夹" Click="Folder_Click"/>
            <Button x:Name="RestartButton" Content="重新开始记录…" Click="Restart_Click" Margin="0,6,0,0" Visibility="Collapsed"/>
          </WrapPanel>
        </StackPanel>
      </Border>
      <Border Background="#F8ECEF" CornerRadius="16" Padding="18">
        <StackPanel>
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="84"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Image x:Name="Preview" Width="80" Height="80" Stretch="Uniform" AutomationProperties.Name="草莓猫"/>
          <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
            <TextBlock x:Name="DayCount" Foreground="#705D68" FontSize="12" Margin="0,0,0,3"/>
            <TextBlock x:Name="StageName" FontSize="24" FontWeight="SemiBold"/>
            <TextBlock x:Name="StageDescription" Margin="0,4,0,0" Foreground="#705D68"/>
          </StackPanel>
        </Grid>
      <UniformGrid x:Name="StageTrail" Columns="4" Margin="-2,10,-2,0">
        <Border Style="{StaticResource StageStep}"><TextBlock Text="初见" TextAlignment="Center" FontSize="12"/></Border>
        <Border Style="{StaticResource StageStep}"><TextBlock Text="熟悉" TextAlignment="Center" FontSize="12"/></Border>
        <Border Style="{StaticResource StageStep}"><TextBlock Text="亲近" TextAlignment="Center" FontSize="12"/></Border>
        <Border Style="{StaticResource StageStep}"><TextBlock Text="默契" TextAlignment="Center" FontSize="12"/></Border>
      </UniformGrid>
      <ProgressBar x:Name="StageProgress" Minimum="0" Maximum="100" Height="5" Margin="0,8,0,10" Foreground="#A56681"
                   Background="#EADDE2" BorderThickness="0" AutomationProperties.Name="下一关系阶段进度"/>
      <TextBlock x:Name="ProgressDescription" Foreground="#705D68" FontSize="12" Margin="0,8,0,10"/>
      <Expander Header="成长说明" Foreground="#705D68" FontSize="12">
        <StackPanel Margin="0,10,0,0">
          <TextBlock x:Name="ScoreDetail" FontWeight="SemiBold" Foreground="#352B35" Margin="0,0,0,5"/>
          <TextBlock x:Name="NextRequirement" Margin="0,0,0,10"/>
          <TextBlock Text="互动、主动开始工作或打开这里后，会记录 30 分钟内的可见陪伴。每天累计 1 分钟开始获得熟悉度，20 分钟达到当日上限。"/>
          <TextBlock Text="不用连续签到，离开也不会失去已经熟悉的关系。" Margin="0,6,0,0"/>
        </StackPanel>
      </Expander>
        </StackPanel>
      </Border>
      <TextBlock x:Name="DisabledNotice" Text="成长记录已暂停，原有回忆仍在这里。" Foreground="#705D68" Margin="0,12,0,0" Visibility="Collapsed"/>
      <Grid Margin="0,24,0,12">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock Text="我们的回忆" FontSize="18" FontWeight="SemiBold"/>
        <TextBlock x:Name="MemoryCount" Grid.Column="1" Foreground="#705D68" FontSize="12" VerticalAlignment="Center"/>
      </Grid>
      <Border x:Name="EmptyCard" Background="White" CornerRadius="12" BorderBrush="#EADDE2" BorderThickness="1" Padding="20,24">
        <TextBlock x:Name="EmptyNotice" Text="和小猫打个招呼，日常会慢慢记在这里。" Foreground="#705D68" TextAlignment="Center"/>
      </Border>
      <StackPanel x:Name="MemoryItems"/>
      <TextBlock x:Name="MigrationNotice" Text="相伴记录从本次更新后开始，之前的日常不会被推算。" Foreground="#705D68" FontSize="12" Margin="0,12,0,0" Visibility="Collapsed"/>
    </StackPanel>
  </ScrollViewer>
  </DockPanel>
</Window>
